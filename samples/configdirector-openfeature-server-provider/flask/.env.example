# Copy to `.env` and fill in your key. Never commit the real thing.
# Server-side SDK key (never exposed to clients)
CONFIGDIRECTOR_SERVER_KEY=your-server-sdk-key

# Verbosity of the SDK's own logger: DEBUG, INFO, WARNING, ERROR.
# Set DEBUG to watch every evaluation as it happens.
CONFIGDIRECTOR_LOG_LEVEL=INFO

# How the SDK retrieves config state: streaming (default) or polling.
CONFIGDIRECTOR_MODE=streaming

# Seconds to wait during initialization before serving defaults.
CONFIGDIRECTOR_TIMEOUT=3

# Only needed when routing through a proxy to reach ConfigDirector.
# CONFIGDIRECTOR_BASE_URL=https://configdirector-proxy.example.com
